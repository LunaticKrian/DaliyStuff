# ── PixelPack 后端环境变量模板 ────────────────────────────────────────
# 用法：在服务器上 `cp server/.env.example server/.env` 后填入真实密钥。
# .env 不进 git、不进镜像，仅由 docker-compose 的 env_file 在运行时注入。
#
# ⚠️ DATABASE_URL 与 UPLOAD_DIR 已在 docker-compose.yml 的 environment 中固定
#    （DATABASE_URL 指向 compose 内网 mysql:3306/pixelpack），这里无需也不应覆盖。
#    但 MySQL 口令由本文件注入（compose 用 ${MYSQL_ROOT_PASSWORD} / ${MYSQL_APP_PASSWORD}）：

# ── MySQL 口令（compose 读取；首启自动建 pixelpack 库 + pixelpack 用户并授权）──
MYSQL_ROOT_PASSWORD=请改成强口令
MYSQL_APP_PASSWORD=请改成强口令

# ── 用户 AI 配置加密（v260729：per-user API Key 加密入库）──
# 标准 Fernet 密钥（base64 urlsafe 32 字节），或任意口令（会经 SHA256 规整为 32 字节）。
# 生产请显式生成并填入；留空则从 SECRET_KEY 派生（仅适合单机自部署）：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── 超级管理员 seed（首启自动创建该账号；明文不入库，首登强制改密）──
SUPERADMIN_USERNAME=super-hero
SUPERADMIN_PASSWORD=QazWsx1314520!

# ── 已废弃（v260729 起，模型 / key 改为每个用户在前端「AI 配置」里自助填写）──
# 下列三项仅为兼容旧 .env 保留，不再作为模型源；新部署无需填写。
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# ANTHROPIC_AUTH_TOKEN=请替换为你的真实 GLM token
# ANTHROPIC_MODEL=glm-5.2

# ── 每日资讯定时生成 ──
INTEL_CRON_HOUR=7
INTEL_CRON_MINUTE=0

# ── Agent 检索 / 产出参数 ──
INTEL_SEARCH_LIMIT=40
INTEL_MIN_ARTICLES=4
INTEL_MAX_ARTICLES=6
